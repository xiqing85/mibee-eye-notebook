# Rust build artifacts
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Config overrides (user-local)
config.local.toml

# Environment files
.env
.env.*

# AI agent knowledge bases (not for distribution)
AGENTS.md
**/AGENTS.md

# AI orchestration workspace
.omo/
.opencode/

# Vendored .deb packages (system deps, not project code)
*.deb

# Dev TLS certificates (generated at runtime)
tls/*.pem
crates/web/tls/*.pem

# Database files (local runtime)
*.db
*.db-shm
*.db-wal

# Build output binary (accidentally generated)
rust_out

# Generated build artifact (build.rs inlines CSS+JS into this from index.template.html)
crates/web/static/index.html

# esbuild bundle output (generated by build.rs from src/)
crates/web/static/app.bundle.js

# Node build-time dependencies (preact, installed via `npm install`).
# NOT shipped — esbuild bundles them into app.bundle.js at build time.
node_modules/
crates/web/static/node_modules/

# Vendored esbuild binary (download separately for air-gapped builds)
tools/esbuild-linux-x64

# Temporary files (safe to rm -rf)
tmp/
