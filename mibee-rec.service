[Unit]
Description=MiBee-Rec (MiBee Rec) Camera Capture Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mibee-rec --config /etc/mibee-rec/config.toml
Restart=on-failure
RestartSec=5
User=mibee-rec
SupplementaryGroups=video
LimitNOFILE=65536
StateDirectory=mibee-rec
WorkingDirectory=/var/lib/mibee-rec

[Install]
WantedBy=multi-user.target
